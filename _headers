# Reglas de caché para Netlify (archivo estándar de Netlify: se sube junto al sitio).
# Objetivo: que el catálogo y el index NUNCA se sirvan con una versión vieja guardada
# en el navegador del visitante, y que imágenes/videos/fuentes sí queden cacheados.

/catalogo.html
  Cache-Control: no-cache, must-revalidate

/catalogo
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
